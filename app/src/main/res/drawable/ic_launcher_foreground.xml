<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Shield Crest base with glowing level pink/neon-cyan gradient -->
    <path
        android:pathData="M54,25 Q78,25 78,48 Q78,78 54,88 Q30,78 30,48 Q30,25 54,25 Z"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="25"
                android:endX="78"
                android:endY="88"
                android:type="linear">
                <item android:color="#FF2E93" android:offset="0.0" />
                <item android:color="#00F5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="25"
                android:endX="78"
                android:endY="88"
                android:type="linear">
                <item android:color="#3F0A3B0F" android:offset="0.0" />
                <item android:color="#20002A3C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Star of Epic Glory right at the center -->
    <path
        android:pathData="M 54,38 L 58.5,47.5 L 68.5,49 L 61,56 L 63,66 L 54,61 L 45,66 L 47,56 L 39.5,49 L 49.5,47.5 Z"
        android:fillColor="#FFD700"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round" />
        
</vector>
